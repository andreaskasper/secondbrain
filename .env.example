# secondbrain - environment
#
# Copy to .env and fill in. Never commit .env.
#
# A single-user install needs nothing beyond the first three values; every
# other line here restates a default and exists so you can see what there is
# to change. For more than one user, mount a config.yaml instead - see
# config.example.yaml.

# --- Required ---------------------------------------------------------------

# The login name. With no config.yaml this is the only account there is.
SECONDBRAIN_USERNAME=andreas

# Literal, or bcrypt:<hash>, or env:NAME, or file:/run/secrets/name.
# Generate a hash with: docker run --rm -it ghcr.io/andreaskasper/secondbrain hashpw
# A literal password must be at least 8 characters.
SECONDBRAIN_PASSWORD=change-me-please

# The URL clients reach this server on, without a trailing slash. Every OAuth
# redirect is derived from it, so it has to be the public address - not the
# container name, not the listen address.
SECONDBRAIN_PUBLIC_URL=http://localhost:2020

# --- Server -----------------------------------------------------------------

# Address inside the container. Change the published port in compose instead
# of this, unless you have a reason to move the listener itself.
SECONDBRAIN_LISTEN=:2020

# Vault root. One directory per vault below it.
SECONDBRAIN_DATA=/data

# The vault a tool call means when it names none. Created on first start.
SECONDBRAIN_DEFAULT_VAULT=default

# Optional multi-user file. Absence is normal and not an error.
SECONDBRAIN_CONFIG=/etc/secondbrain/config.yaml

# --- Versioning -------------------------------------------------------------

# Every write becomes a commit in <vault>/.git. This is what note_history,
# note_diff and note_restore read; turning it off gives up all three.
SECONDBRAIN_GIT=true

# Set to push after every commit. Off by default: an unreachable remote would
# turn every note edit into a network round trip that can fail.
SECONDBRAIN_GIT_REMOTE=

# Credential for that push, for example a GitHub personal access token.
SECONDBRAIN_GIT_TOKEN=

# Who the commits are attributed to.
SECONDBRAIN_GIT_AUTHOR=secondbrain
SECONDBRAIN_GIT_EMAIL=secondbrain@localhost

# --- Limits -----------------------------------------------------------------

# Ceiling on a single tool result, in bytes, before it is truncated. Raising
# it mostly buys longer notes reaching the model in one piece; 262144 is 256
# KiB and the minimum accepted is 4096.
SECONDBRAIN_MAX_RESPONSE_BYTES=262144

# How long an access token stays valid. Tokens live in memory only, so a
# restart invalidates them regardless.
SECONDBRAIN_TOKEN_TTL=12h

# How long an OAuth authorization code stays redeemable. Seconds, not
# minutes: the code is exchanged immediately or not at all.
SECONDBRAIN_CODE_TTL=60s

# How long deleted or overwritten notes stay in .secondbrain/trash/ before
# they are purged. 720h is 30 days. Nothing is ever removed outright.
SECONDBRAIN_TRASH_RETENTION=720h

# --- Access and logging -----------------------------------------------------

# Comma-separated list of browser origins allowed to call /mcp. Empty means
# no Origin check at all, which is what hosted clients such as claude.ai
# need. Set it only when every client of yours is one you control.
SECONDBRAIN_ALLOWED_ORIGINS=

# debug|info|warn|error. Note content is never logged at any level; the audit
# line carries user, vault, tool, path, byte count and duration.
SECONDBRAIN_LOG_LEVEL=info

# --- Metrics ----------------------------------------------------------------

# A Prometheus endpoint, off by default. An endpoint reporting how many notes
# you have and when you last wrote one does not belong on a listener unasked.
SECONDBRAIN_METRICS=false

# Where on the listener. Must start with a slash and must not collide with
# /mcp, /healthz or /.
SECONDBRAIN_METRICS_PATH=/metrics

# Shared key a scraper has to present, as "Authorization: Bearer <key>" or as
# "X-API-Key". Compared in constant time; anything shorter than 16 characters
# is refused at startup. Also accepts env:NAME and file:/run/secrets/name.
# Generate one with: openssl rand -hex 32
SECONDBRAIN_METRICS_KEY=replace-with-a-random-32-byte-hex-string

# Serve the metrics on their own address instead - and only there, so the
# main listener answers a real 404. This is the stronger of the two
# protections: a port bound inside the Docker network and never published in
# compose cannot be reached from outside, whatever the key is. Leave it unset
# unless a scraper shares that network; see deploy/prometheus/.
# SECONDBRAIN_METRICS_LISTEN=:9090

# --- Referenced from config.yaml --------------------------------------------

# Values a config.yaml can pull in with password: "env:NAME", so the file
# itself stays free of credentials and can be committed.
RESEARCH_PASSWORD=
