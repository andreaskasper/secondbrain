# Copy to .env and fill in. Never commit .env.

# The public hostname you attached to the tunnel in the Zero Trust dashboard.
SECONDBRAIN_HOST=notes.example.com

# Zero Trust -> Networks -> Tunnels -> your tunnel -> Install connector.
# The token is a credential for your account: treat it like a password.
TUNNEL_TOKEN=

# The single account, unless you mount a config.yaml with a users: list.
SECONDBRAIN_USERNAME=andreas

# Literal, or bcrypt:<hash>, or env:NAME, or file:/run/secrets/name. Generate
# a hash with:
#   docker run --rm -it ghcr.io/andreaskasper/secondbrain hashpw
SECONDBRAIN_PASSWORD=

SECONDBRAIN_LOG_LEVEL=info

# Optional: push every commit to a repository you control.
SECONDBRAIN_GIT_REMOTE=
SECONDBRAIN_GIT_TOKEN=

# Referenced as env: from config.yaml, if you use one.
RESEARCH_PASSWORD=
