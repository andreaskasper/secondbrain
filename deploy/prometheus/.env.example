# Copy to .env and fill in. Never commit .env.

# The URL clients reach secondbrain on. Every OAuth redirect is derived from
# it. Behind Traefik or a tunnel this is the public https:// address.
SECONDBRAIN_PUBLIC_URL=http://localhost:2020

# The single account, unless you mount a config.yaml with a users: list.
SECONDBRAIN_USERNAME=andreas

# Literal, or bcrypt:<hash>, or env:NAME, or file:/run/secrets/name. Generate
# a hash with:
#   docker run --rm -it ghcr.io/andreaskasper/secondbrain hashpw
SECONDBRAIN_PASSWORD=

SECONDBRAIN_LOG_LEVEL=info

# The scrape credential. At least 16 characters:
#   openssl rand -hex 32
# The identical value must be in ./secondbrain.key, without a trailing
# newline, because that is the file Prometheus reads:
#   printf '%s' "<the key>" > secondbrain.key
SECONDBRAIN_METRICS_KEY=

# Where the metrics are served. The listener is a second one inside the
# container and its port is never published; see docker-compose.yml.
SECONDBRAIN_METRICS_PATH=/metrics
SECONDBRAIN_METRICS_LISTEN=:9090
